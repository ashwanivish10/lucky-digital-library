# Lucky Digital Library

## Environment Variables — Copy this to `.env` and fill in your values.

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ldl?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_DOMAIN=localhost

# Uploads
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Seed Admin (used only by npm run seed)
SEED_ADMIN_NAME=Library Admin
SEED_ADMIN_EMAIL=admin@luckylibrary.in
SEED_ADMIN_PASSWORD=Admin@1234

# App Timezone
TZ=Asia/Kolkata
